    "effect_source": { "page": "Functions", "url": "https://thefarmerwasreplaced.wiki.gg/wiki/Functions", "checked": "2026-10-20" },
    "operation_cost_source": { "page": "Operation Costs", "url": "https://thefarmerwasreplaced.wiki.gg/wiki/Operation_Costs", "checked": "2026-10-20" },
    "description": "Define custom functions.",
    "source": { "page": "Unlocks", "url": "https://thefarmerwasreplaced.wiki.gg/wiki/Unlocks", "last_edited": "2026-08-07" }
  },
