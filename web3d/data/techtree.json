  "Lists": {
    "category": "Coding Core",
    "position": { "x": 600, "y": 520 },
    "visual_parents": ["Variables"],
    "prerequisites": ["Variables"],
    "cost": { "carrot": 500 },
    "description": "Use lists to store multiple values.",
    "features": ["lists"],
    "usage": "Create lists with [value, ...] and tuples with (value, ...); read either with [index], slice lists, concatenate collections with +, and test list/tuple membership with in or not in. Use len(), list(collection), and for iteration; modify lists with insert(index, value) or remove(value). append() and pop() remain unavailable until their operation costs are verified.",
    "source_code": "items = [1, 2, 3]\nitems.insert(1, 4)\nitems.remove(2)\nfor item in items:\n    harvest()",
    "effect_source": { "page": "Lists", "url": "https://thefarmerwasreplaced.wiki.gg/wiki/Lists", "checked": "2026-10-20" },
    "operation_cost_source": { "page": "Operation Costs", "url": "https://thefarmerwasreplaced.wiki.gg/wiki/Operation_Costs", "checked": "2026-10-20" },
    "source": { "page": "Unlocks", "url": "https://thefarmerwasreplaced.wiki.gg/wiki/Unlocks", "last_edited": "2026-08-07" }
  },
  "Dictionaries": {
